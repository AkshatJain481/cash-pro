# Copy this file to `.env` and fill in the values.

# ── Database (CockroachDB) ────────────────────────────────────────────
# CockroachDB Cloud: Cluster → Connect → "General connection string".
# Local single node: postgresql://root@localhost:26257/cashpro?sslmode=disable
DATABASE_URL=

# ── Better Auth ───────────────────────────────────────────────────────
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app (no trailing slash), e.g. http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
